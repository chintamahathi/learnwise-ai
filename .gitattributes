# Normalize all text files to LF in the repo.
# This prevents Prettier/ESLint CRLF errors on Windows checkouts.
* text=auto eol=lf

# Explicitly binary files — no line ending conversion
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
